# Copy to .env and adjust. All variables are optional; defaults live in src/rag/config.py.
RAG_LOG_LEVEL=INFO
RAG_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
RAG_S3_ENDPOINT_URL=http://localhost:9000
RAG_S3_ACCESS_KEY=minioadmin
RAG_S3_SECRET_KEY=change-me
RAG_S3_BUCKET=raw-laws
RAG_RETRIEVAL_MODE=vector
RAG_TOP_K=5
RAG_LLM_ENABLED=false

# Compose stack (defaults are for local use only)
POSTGRES_PASSWORD=rag
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_JWT_SECRET=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
